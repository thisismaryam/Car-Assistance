+# Parsed back out of our own booking summary so that "Confirm" books exactly what was shown.
+SUMMARY_PROMPT_MARKER = "would you like me to confirm and execute this booking now"
+SUMMARY_SERVICE_RE = re.compile(r"\*\*Service\*\*:\s*(.+?)\s*\((?:Workshop|Home|Roadside)\)", re.I)
+SUMMARY_VEHICLE_RE = re.compile(r"\*\*Vehicle\*\*:\s*(.+)")
+SUMMARY_TIME_RE = re.compile(r"\*\*(\d{4}-\d{2}-\d{2} \d{2}:\d{2}) UTC\*\*")
+SUMMARY_LOCATION_RE = re.compile(r"\*\*Location\*\*:\s*(.+)")
+
+
+def _pending_booking_from_history(history: list[dict[str, str]]) -> dict[str, Any] | None:
+    """If the last assistant message is our booking summary, return what it proposed."""
+    last = next((m.get("content", "") for m in reversed(history or []) if m.get("role") == "assistant"), "")
+    if SUMMARY_PROMPT_MARKER not in last.lower():
+        return None
+    service = SUMMARY_SERVICE_RE.search(last)
+    vehicle = SUMMARY_VEHICLE_RE.search(last)
+    when = SUMMARY_TIME_RE.search(last)
+    location = SUMMARY_LOCATION_RE.search(last)
+    scheduled_at = None
+    if when:
+        try:
+            scheduled_at = datetime.strptime(when.group(1), "%Y-%m-%d %H:%M").replace(tzinfo=timezone.utc)
+        except ValueError:
+            scheduled_at = None
+    return {
+        "service_name": service.group(1).strip() if service else None,
+        "vehicle_display": vehicle.group(1).strip() if vehicle else None,
+        "scheduled_at": scheduled_at,
+        "address": location.group(1).strip() if location else None,
+    }
+
+
